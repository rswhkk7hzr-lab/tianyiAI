# 学术论文图表样式（matplotlib style）
# 用法: plt.style.use(r'<本技能目录>\assets\academic.mplstyle')
# 适配中文学术期刊常见规范：300 DPI、衬线字体、刻度朝内、四边刻度

# --- 输出 ---
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.05
figure.figsize: 7.5, 4.5

# --- 字体 ---
font.family: serif
font.serif: Times New Roman, SimSun, STSong, DejaVu Serif
font.size: 10.5
axes.unicode_minus: False
pdf.fonttype: 42
ps.fonttype: 42

# --- 坐标轴 ---
axes.labelsize: 10.5
axes.titlesize: 11
axes.linewidth: 0.8
axes.grid: False
grid.alpha: 0.3
grid.linewidth: 0.5
grid.linestyle: --

# --- 刻度 ---
xtick.labelsize: 9
ytick.labelsize: 9
xtick.direction: in
ytick.direction: in
xtick.top: True
ytick.right: True
xtick.major.size: 4
ytick.major.size: 4
xtick.minor.size: 2
ytick.minor.size: 2
xtick.major.width: 0.8
ytick.major.width: 0.8

# --- 线条与图例 ---
lines.linewidth: 1.5
lines.markersize: 5
legend.fontsize: 9
legend.frameon: False
legend.handlelength: 1.8

# --- 配色周期（黑白友好 + 色盲友好倾向）---
axes.prop_cycle: cycler('color', ['000000', 'E0342D', '2E5B9F', '0B8A6D', 'B95C00', '8C4BA0', '777777', 'D4A0B5'])
